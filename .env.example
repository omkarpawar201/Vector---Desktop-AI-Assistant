# =====================================================================
# Vector — Desktop AI Assistant Configuration
# =====================================================================

# --- Gemini API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Needle 2 Local Model Settings ---
NEEDLE_MODEL_PATH=models/needle_2.onnx
NEEDLE_CONFIDENCE_THRESHOLD=0.85

# --- Assistant Feature Toggles ---
ENABLE_GEMINI=true
ENABLE_LOCAL_LLM=false
ENABLE_VOICE=false
REQUIRE_CONFIRMATION_FOR_DANGEROUS=true

# --- Database & Logging ---
DATABASE_PATH=data/vector.db
LOG_LEVEL=INFO
