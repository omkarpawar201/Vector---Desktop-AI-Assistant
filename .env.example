# =====================================================================
# Vector — Desktop AI Assistant Configuration
# =====================================================================

# --- Gemini API Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Needle Local Model Settings ---
NEEDLE_MODEL_PATH=models/needle_2_custom.onnx
NEEDLE_OFFICIAL_WEIGHTS_PATH=models/needle3.cact
NEEDLE_TUNED_WEIGHTS_PATH=models/needle3_vector_v4.cact
NEEDLE_GENERATION=3
NEEDLE_MAX_DECODE_TOKENS=64
NEEDLE_CANDIDATE_USE_EMBEDDING=false
NEEDLE_CANDIDATE_SIMILARITY=0.55
NEEDLE_CONFIDENCE_THRESHOLD=0.85

# --- Assistant Feature Toggles ---
ENABLE_GEMINI=true
ENABLE_LOCAL_LLM=false
ENABLE_VOICE=false
REQUIRE_CONFIRMATION_FOR_DANGEROUS=true

# --- Voice Speech-to-Text ---
VOICE_STT_BACKEND=online
VOICE_STT_MODEL_DIR=models/stt

# --- Database & Logging ---
DATABASE_PATH=data/vector.db
LOG_LEVEL=INFO
